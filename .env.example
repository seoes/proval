DB_FILE_NAME=file:local.db
ENCRYPTION_KEY="ABCD1234=" # openssl rand -base64 32
# COOKIE_SECURE=true  # set when the dashboard is served over HTTPS
# Reviews allowed to run at once; later ones wait in arrival order. Unset or 0 is unlimited.
# The model provider concurrency bounds calls in flight; this bounds whole reviews, so a
# burst of webhooks finishes one review after another instead of all of them slowly.
PROVAL_REVIEW_CONCURRENCY=2
