DB_FILE_NAME=file:local.db
ENCRYPTION_KEY="ABCD1234=" # openssl rand -base64 32
# COOKIE_SECURE=true  # set when the dashboard is served over HTTPS
# Most review units the planner may create for one review. Unset leaves it to the planner.
# On a wide change the planner can choose more units than the step budget can carry; one
# 30 file merge request became 14 units, ran out of steps before a hand off and spent 9M
# input tokens for nothing. Six is a sound ceiling for most repositories.
PROVAL_REVIEW_UNIT_CAP=6
