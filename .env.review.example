# Copy to .env.review and fill in (.env.review is gitignored)
# Required
REPO_URL=https://gitlab.example.com/org/repo.git
BASE_BRANCH=main
HEAD_BRANCH=feature/my-branch
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk_...
LLM_MODEL=gpt-5.4

# Optional
# REPO_TOKEN=
# PR_TITLE=local review
# PR_BODY=
# LANGUAGE=English
# INLINE_REVIEW=true
# SAVE_RESULT=none # none | json | markdown
