{
    "name": "cli",
    "type": "module",
    "bin": {
        "proval": "./dist/index.js"
    },
    "scripts": {
        "dev": "bun --no-clear-screen src/index.ts",
        "typecheck": "tsc --noEmit",
        "build": "bun build src/index.ts --outdir dist --target bun",
        "compile": "bun build src/index.ts --compile --outfile ./proval",
        "test": "bun test",
        "lint": "prettier --check . && eslint .",
        "format": "prettier --write ."
    },
    "dependencies": {
        "@proval/types": "workspace:*"
    },
    "devDependencies": {
        "@types/bun": "^1.3.11",
        "eslint": "^9.39.2",
        "prettier": "^3.8.1",
        "typescript": "^5.8.3"
    }
}
